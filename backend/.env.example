# Copy this file to .env and fill in your own values.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scener?retryWrites=true&w=majority
JWT_SECRET=any-long-random-string
PORT=5000

# Optional locally, required when deployed. From your Cloudinary dashboard ("API environment variable").
# If empty, posters are saved to backend/uploads instead.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
